# MCP Router operator template:  cp .env.example .env  then fill the REQUIRED
# block. docker compose loads this whole file into the api container
# (env_file) and interpolates ${VAR} in docker-compose*.yml from it.
# Empty value = unset (the default applies). Every optional line below is
# commented out and shows the DEFAULT; uncomment only what you change (an
# uncommented line also overrides the image's own defaults, e.g. cache dirs).

# ---------------------------------------------------------------- REQUIRED ---
# Admin API bearer token, >= 32 chars:  openssl rand -hex 32
# Unset => the router listens on loopback only inside the container (fail closed).
MCPR_ADMIN_TOKEN=
# Agent keys, comma-separated agent_id:key pairs, each key >= 32 chars:
#   echo "my-agent:$(openssl rand -hex 32)"
MCPR_AGENT_KEYS=
# Postgres password for the bundled db (no default; must be URL-safe):
#   openssl rand -hex 24
POSTGRES_PASSWORD=

# ------------------------------------------------------- network / compose ---
# Host interface compose publishes the API on (127.0.0.1 | 0.0.0.0). Publish
# beyond loopback only with MCPR_ADMIN_TOKEN set.
# MCPR_BIND=127.0.0.1
# MCPR_HOST_PORT=8400
# Extra Host names the app accepts besides localhost/127.0.0.1/[::1]
# (comma list; host or host:port). Anything else gets 421 (DNS-rebinding guard).
# MCPR_ALLOWED_HOSTS=
# Bind 0.0.0.0 inside the container WITHOUT an admin token (dev only; open API).
# MCPR_ALLOW_OPEN_DEV=false
# POSTGRES_USER=mcprouter
# POSTGRES_DB=mcprouter
# Container-internal port uvicorn listens on (compose maps host -> 8400).
# MCPR_PORT=8400
# Seconds-spaced attempts (2 s apart) the entrypoint waits for Postgres.
# MCPR_DB_WAIT_TRIES=30
# Directory the entrypoint probes for writability (image volume).
# MCPR_DATA_DIR=/data
# Bare metal only: compose always derives MCPR_DATABASE_URL from POSTGRES_*
# (its explicit value wins over this file).
# MCPR_DATABASE_URL=postgresql+psycopg://mcprouter:mcprouter@localhost:5434/mcprouter
# Image tags compose builds/uses.
# MCPR_IMAGE=mcp-router:local
# MCPR_BASE_IMAGE=mcp-router:local
# MCPR_INFERENCE_IMAGE=mcp-router:local-inference
# MCPR_TORCH_INDEX_URL=https://download.pytorch.org/whl/cu124

# ----------------------------------------------------------------- logging ---
# MCPR_LOG_LEVEL=INFO                   # DEBUG | INFO | WARNING | ERROR | CRITICAL
# MCPR_LOG_FORMAT=console               # console | json  (compose sets json)

# ------------------------------------------------- inference (docs/backends.md)
# MCPR_EMBEDDING_BACKEND=hash           # hash | bge | aoai  (bge needs the inference image)
# MCPR_EMBEDDING_MODEL_ID=BAAI/bge-small-en-v1.5
# MCPR_DECISION_BACKEND=deterministic   # deterministic | laya | remote | aoai
# MCPR_LAYA_MODEL_ID=convaiinnovations/laya
# MCPR_LAYA_NOUL_MODE=choice            # choice | native
# MCPR_DEVICE=auto                      # auto | cpu | cuda | cuda:<index>
# MCPR_OPERATING_MODE=balanced          # performance | balanced | battery
# MCPR_MODELS_CACHE_DIR=./models-cache  # image default: /srv/models-cache
# MCPR_IDLE_UNLOAD_S=300                # battery mode only
# MCPR_EMBED_BATCH_SIZE=32
# MCPR_DECISION_TIMEOUT_S=2
# Remote decision backend (MCPR_DECISION_BACKEND=remote)
# MCPR_DECISION_ENDPOINT=https://api.aimlapi.com/v1/decisions
# MCPR_DECISION_MODEL=typesafe/jev
# MCPR_DECISION_API_KEY=
# MCPR_DECISION_API_KEY_FILE=/run/secrets/decision_key   # wins over the plain var
# MCPR_DECISION_MAX_RETRIES=2           # 0..10
# MCPR_DECISION_RATE_LIMIT_PER_MIN=120  # decision edge, per principal
# Azure OpenAI (MCPR_DECISION_BACKEND=aoai and/or MCPR_EMBEDDING_BACKEND=aoai)
# MCPR_AOAI_ENDPOINT=https://<resource>.openai.azure.com
# MCPR_AOAI_API_KEY=
# MCPR_AOAI_API_KEY_FILE=/run/secrets/aoai_key           # wins over the plain var
# MCPR_AOAI_CHAT_DEPLOYMENT=
# MCPR_AOAI_EMBEDDING_DEPLOYMENT=
# MCPR_AOAI_MAX_RETRIES=2               # 0..10

# ----------------------------------------------------------------- routing ---
# MCPR_MAX_EXPOSED_TOOLS=8
# MCPR_MAX_EXPOSED_SERVERS=             # empty = unlimited
# MCPR_RETRIEVAL_CANDIDATES=20
# MCPR_ROUTE_CONFIDENCE_FLOOR=0.35      # 0..1
# MCPR_ROUTE_CACHE_TTL_S=60             # 0 disables the route cache
# MCPR_ROUTE_CACHE_SIZE=1024            # 0 disables the route cache

# ---------------------------------------------------- MCP gateway / execution ---
# MCPR_MCP_MAX_SESSIONS=1000
# MCPR_MCP_MAX_SESSIONS_PER_AGENT=32
# MCPR_DEFAULT_TOOL_TIMEOUT_S=30
# MCPR_RATE_LIMIT_PER_AGENT_PER_MIN=120

# --------------------------------------------- discovery / analytics / dedup ---
# MCPR_SYNC_ENABLED=false               # background catalog sync + health loop
# MCPR_USAGE_PRIOR_ENABLED=false
# MCPR_ANALYTICS_ROLLUP_ENABLED=false
# MCPR_PREFILL_MS_PER_1K_TOKENS=0       # 0 = estimate not configured
# MCPR_PRICE_PER_1K_INPUT_TOKENS=0
# MCPR_CURRENCY=USD
# MCPR_DEDUP_MAX_PAIRS=5000

# ------------------------------------------------- Agent Skills (docs/skills.md)
# MCPR_MAX_EXPOSED_SKILLS=3             # global cap on routed skills per request
# MCPR_SKILL_BODY_MAX_BYTES=65536       # SKILL.md body cap (over -> body_truncated)
# MCPR_SKILL_RESOURCE_MAX_BYTES=5242880 # per-resource serve cap (over -> resource_oversize)
# MCPR_SKILLS_CACHE_DIR=./skills-cache  # image default: /srv/skills-cache

# -------------------------------------------------------------- dashboard ---
# MCPR_UI_DIST=./ui/dist                # image default: /srv/ui/dist
