# Inference backends — see docs/backends.md
# MCPR_DECISION_BACKEND=laya            # laya | deterministic | remote | aoai
# MCPR_DECISION_ENDPOINT=https://api.aimlapi.com/v1/decisions
# MCPR_DECISION_MODEL=typesafe/jev
# MCPR_DECISION_API_KEY=
# MCPR_DECISION_API_KEY_FILE=/run/secrets/decision_key
# MCPR_DECISION_MAX_RETRIES=2
# MCPR_EMBEDDING_BACKEND=local          # local | aoai
# MCPR_AOAI_ENDPOINT=https://<resource>.openai.azure.com
# MCPR_AOAI_API_KEY=
# MCPR_AOAI_API_KEY_FILE=/run/secrets/aoai_key
# MCPR_AOAI_CHAT_DEPLOYMENT=
# MCPR_AOAI_EMBEDDING_DEPLOYMENT=
# MCPR_AOAI_MAX_RETRIES=2
# Agent Skills (v0.4) — see docs/skills.md
# MCPR_MAX_EXPOSED_SKILLS=3             # global cap on routed skills per request
# MCPR_SKILL_BODY_MAX_BYTES=65536       # SKILL.md body cap (over -> body_truncated)
# MCPR_SKILL_RESOURCE_MAX_BYTES=5242880 # per-resource serve cap (over -> resource_oversize)
# MCPR_SKILLS_CACHE_DIR=./skills-cache  # where git skill sources are cloned
