# DevDependencies (vitest, @testing-library) must always install in this package.
# Project config outranks user/global npmrc for the same key; with an omit present
# in a lower-priority npmrc, include=dev forces the dev group back in. An env-level
# NPM_CONFIG_OMIT still wins over npmrc files (documented npm precedence) and cannot
# be overridden from inside the repo.
include=dev
